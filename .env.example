# Copy this file to .env and fill in your own values. Never commit the real .env.

# --- Required ---

# Signs Flask session cookies. Use a long, random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# From your app on the EVE developer portal (https://developers.eveonline.com)
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Must match the Callback URL registered on your EVE developer app exactly.
EVE_CALLBACK_URL=http://localhost:5000/callback

# --- Optional ---

# Database connection. Defaults to local SQLite if unset.
# For production Postgres: postgresql+psycopg2://user:pass@host:5432/dbname
# DATABASE_URL=

# CCP asks every ESI client to identify itself with a contact address.
# ESI_USER_AGENT=eve-indy-toolbox/1.0 (you@example.com)

# Set to "false" on every process except one when running multiple workers,
# so the 30-minute sync job doesn't run once per worker. Defaults to "true".
# RUN_SCHEDULER=true

# Enables Flask's auto-reload and interactive debugger. LOCAL DEV ONLY —
# never enable this in production (it exposes a code-executing console).
# FLASK_DEBUG=false

# Ntfy push notifications. Bare topic name -> ntfy.sh, or a full URL for a
# self-hosted server. Leave unset to disable notifications entirely.
# NTFY_TOPIC=

# --- Security (REQUIRED on any real deployment) ---

# Encrypts EVE OAuth tokens at rest (a leaked DB file is useless without it).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key OUT of database backups. Losing it means everyone re-links
# their characters; unset means tokens are stored in plaintext (dev only).
# TOKEN_ENCRYPTION_KEY=

# Session cookie only sent over HTTPS. MUST be "true" behind TLS in
# production; defaults to "false" because localhost dev is plain HTTP.
# SESSION_COOKIE_SECURE=true

# Only characters in these corporations may be linked (comma-separated EVE
# corporation IDs). Unset = gate off (local dev). Fails closed if ESI can't
# verify membership.
# ALLOWED_CORP_IDS=

# --- Corp website integration (see app/integration.py) ---

# "local" (default) = standalone dev, single local admin.
# "corp" = identity comes from the host site via resolve_current_identity().
# INTEGRATION_MODE=local

# Which of the host site's rank names get corp-wide (admin) visibility.
# Case-insensitive, exact match. Anything else is a regular member.
# ADMIN_ROLES=admin,director,hr,ceo

# Where to send signed-out visitors / where the host site's logout lives.
# CORP_LOGIN_URL=
# CORP_LOGOUT_URL=
